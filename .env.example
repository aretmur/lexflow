# Environment variables for local development and Vercel.
# Copy to `.env.local` and fill with your Supabase project values.
# Never commit real secrets.

# Required. Project URL from Supabase Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Required. Publishable (legacy name: anon) key from Supabase Settings → API.
# Safe to expose in the browser; access is constrained by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional alias. Used only if NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for auth email redirects in production. Use the deployed origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required for Dropbox Sign webhook writes and signed-PDF ingest.
# Never expose this key in the browser. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. native_lexflow (default) or dropbox_sign.
# SIGNING_PROVIDER=native_lexflow

# Explicit test mode for native Lexflow signing. Production must leave this unset.
# SIGNING_TEST_MODE=true

# Server-only Dropbox Sign credentials. Required only if a firm uses Dropbox Sign.
# Never prefix with NEXT_PUBLIC_.
# DROPBOX_SIGN_API_KEY=your-dropbox-sign-api-key
# DROPBOX_SIGN_CLIENT_ID=your-dropbox-sign-client-id

# Explicit test mode only. Production must set this to false or leave unset.
# DROPBOX_SIGN_TEST_MODE=true

# Server-only email delivery. Never prefix these with NEXT_PUBLIC_.
# microsoft_graph | resend | console
EMAIL_PROVIDER=microsoft_graph

# Microsoft 365 / Microsoft Graph. Required when EMAIL_PROVIDER=microsoft_graph.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER=intake@octagonlegal.au

# Optional alternative provider. Required only when EMAIL_PROVIDER=resend.
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_REPLY_TO=

# EMAIL_PROVIDER=console uses local logging only. Do not set this in production.
