# Environment variables for local development and Vercel.
# Copy to `.env.local` and fill with your Supabase project values.
# Never commit real secrets.

# Required. Project URL from Supabase Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Required. Anon (public) key from Supabase Settings → API.
# Safe to expose in the browser; access is constrained by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for auth email redirects in production. Use the deployed origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Do not put SUPABASE_SERVICE_ROLE_KEY in this Next.js app.
# It bypasses row-level security and must never ship to the client.
